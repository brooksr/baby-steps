VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_SHEET_ID=
# Optional: link the admin checklist to your project's Audience page.
VITE_GOOGLE_CLOUD_PROJECT=
# Optional: set to true once the OAuth consent screen is "In production".
VITE_GOOGLE_OAUTH_PUBLISHED=
# Optional: the Google Picker, so the app can share a sheet it did not create.
# Create the key in the SAME project as the OAuth client; restrict it to the
# Picker API and your site. The Picker's app id is read from the client id.
VITE_GOOGLE_API_KEY=
# Optional: one-time sign-in through the token broker (server/token-broker.mjs)
# served at this path on the same origin. Leave unset for a plain static host.
VITE_GOOGLE_TOKEN_BROKER=
