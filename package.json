{
  "name": "babysteps",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "android:build": "cd android && ./gradlew :app:assembleDebug :wear:assembleDebug",
    "android:lint": "cd android && ./gradlew :app:lintDebug :wear:lintDebug :internal-client:lintDebug",
    "android:test": "cd android && ./gradlew :app:testDebugUnitTest :wear:testDebugUnitTest :internal-client:testDebugUnitTest",
    "build": "tsc -b && vite build",
    "build:internal": "vite build --config vite.internal.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "start:internal": "node dist-internal/internal-api.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build:internal && playwright test",
    "test:internal": "vitest run src/server/internal",
    "test:receiver": "node android/integration/google-apps-script/receiver.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "dexie": "^4.0.11",
    "jose": "6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
